# API server port. Many hosts set this automatically.
PORT=3001

# Set to production on the live server.
NODE_ENV=production

# Change in production. Use a private random value with at least 32 characters.
JWT_SECRET=replace-with-a-private-random-32-plus-character-secret

# PostgreSQL connection string (required). Supabase/Railway/Neon provide this.
DATABASE_URL=postgresql://user:password@localhost:5432/madrasah

# Set to true for managed PostgreSQL providers that require SSL (Supabase, Neon, etc.)
# DATABASE_SSL=true

# Live server first admin. Used only when the database is completely empty.
INITIAL_ADMIN_NAME=Super Admin
INITIAL_ADMIN_EMAIL=admin@example.com
INITIAL_ADMIN_PASSWORD=replace-with-a-private-password

# Keep this false/missing in production unless you intentionally want a temporary public setup screen.
# ENABLE_PUBLIC_SETUP=false

# Frontend origin for CORS. Use your real HTTPS domain in production.
CLIENT_ORIGIN=https://your-domain.com

# Optional: override API base URL if frontend and backend are hosted separately.
# VITE_API_URL=https://api.your-domain.com/api

# Cloudinary (used to store student photos, documents, and the site logo instead of base64 in the database)
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret

# Google Drive backup destination (OAuth). Create an OAuth 2.0 Client ID
# ("Web application") in Google Cloud Console, enable the Drive API, and add
# GOOGLE_DRIVE_REDIRECT_URI below as an Authorized redirect URI.
# Leave unset to hide the Google Drive option in Settings.
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-client-secret
GOOGLE_DRIVE_REDIRECT_URI=https://api.your-domain.com/api/backup/google/callback

# Encrypts backup files (AES-256) before they're uploaded to Google Drive, so
# the data is unreadable to anyone who only has access to that Drive account
# (wrong sharing, compromised account, etc). Local backups on this server are
# NOT affected — only the copy that leaves the server for Drive. Use a long
# random value and store it somewhere safe outside of Drive: if this key is
# lost, encrypted Drive backups can never be restored. Leave unset to keep
# uploading Drive backups as plain, readable JSON/SQL (not recommended).
# Generate one with: openssl rand -base64 32
BACKUP_ENCRYPTION_KEY=replace-with-a-private-random-32-plus-character-secret

# Connection string for a SEPARATE, throwaway Postgres database used only by
# `npm run test:backup` (scripts/backup-restore.test.js) to verify backup/
# restore actually round-trips data correctly. This is truncated and
# rewritten repeatedly by the test — never point it at DATABASE_URL above.
# The database name must contain "test" (case-insensitive) as a safety net,
# unless you run with ALLOW_NONTEST_DB=yes. Leave unset if you don't want
# to run this test locally.
# BACKUP_TEST_DATABASE_URL=postgresql://user:password@localhost:5432/madrasah_test

# Email (password reset) — sent via Resend's HTTPS API, not SMTP, since most
# hosts (Render's free tier since Sep 2025, and port 25 even on paid plans)
# block outbound SMTP ports. Sign up free at https://resend.com, create an
# API key, and set it here. EMAIL_FROM must be on a domain verified in
# Resend — for quick testing before verifying your own domain, leave it
# unset to use Resend's shared onboarding@resend.dev sender.
RESEND_API_KEY=re_your_resend_api_key
EMAIL_FROM=your-email@yourdomain.com

# SMS (BUSINESS_READINESS_ROADMAP.md Phase 8B) — sent via lib/smsSender.js,
# same env-var-driven/no-op-if-unset pattern as email above. Leave
# SMS_PROVIDER_API_KEY unset to keep SMS disabled (every call is a silent
# no-op). Provider defaults to BulkSMSBD (bulksmsbd.net) — sign up there for
# an api_key and an approved senderid. SMS_COST_PER_SMS is the taka amount
# deducted from an institution's SMS wallet per SMS sent; update it once the
# real BulkSMSBD rate for this account's recharge tier is confirmed.
# SMS_PROVIDER=bulksmsbd
# SMS_PROVIDER_API_KEY=your_bulksmsbd_api_key
# SMS_PROVIDER_SENDER_ID=your_approved_sender_id
# SMS_COST_PER_SMS=0.4

# SMS wallet manual top-up (Phase 8D) — the personal bKash number shown on
# the institution-admin's "SMS সেবা" settings page for them to send money
# to before submitting a Trx ID. Leave unset and the page shows a fallback
# "contact the platform operator" message instead of a number. Purely
# display text (routes/sms.js) — never used to verify anything server-side,
# since verification is a human checking their own bKash inbox from the
# Super-Admin panel (routes/platform.js's sms-topups endpoints).
# SMS_TOPUP_BKASH_NUMBER=01XXXXXXXXX

# ---------------------------------------------------------------------------
# Guardian Push Notifications (docs/PUSH_NOTIFICATION_PLAN.md — Phase 0)
# ---------------------------------------------------------------------------
# Web Push (VAPID) — sends real browser/phone push notifications to guardians
# for reminders and class posts/notices. No Google/Firebase account needed;
# these are a self-generated EC keypair the Web Push standard requires to
# sign push messages. Generate a fresh pair with (pure Node, no npm install
# needed — same algorithm the `web-push` package's own generator uses):
#   node -e "const c=require('crypto');function b64url(b){return b.toString('base64').replace(/\+/g,'-').replace(/\//g,'_').replace(/=+$/,'')}const k=c.createECDH('prime256v1');k.generateKeys();const priv=k.getPrivateKey();console.log('VAPID_PUBLIC_KEY='+b64url(k.getPublicKey()));console.log('VAPID_PRIVATE_KEY='+b64url(Buffer.concat([Buffer.alloc(32-priv.length),priv])))"
# Leave both unset to keep push disabled (guardian portal falls back to the
# existing 45-second polling bell/messenger bubble — nothing breaks).
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT is a mailto: address required by the Web Push spec for the
# push service to contact you if something's wrong (e.g. sending too much) —
# no email is ever sent automatically because of this.
# VAPID_SUBJECT=mailto:admin@your-domain.com

# ---------------------------------------------------------------------------
# Multi-tenant registry (Part 1/6 — see docs/MULTI_TENANT_PLAN.md)
# ---------------------------------------------------------------------------
# Optional. Leave unset to keep the registry (list of institutions/tenants)
# in the SAME database as DATABASE_URL, just in its own "registry" schema —
# this is the default and is fine for most setups. Only set this if you want
# the registry on a completely separate physical database.
# REGISTRY_DATABASE_URL=postgresql://user:password@localhost:5432/madrasah_registry

# Multi-tenant Part 3 — Tenant Resolution Middleware. Leave unset/false for a
# normal single-tenant deployment (this app's default) — nothing below has
# any effect until this is "true".
# MULTI_TENANT_MODE=true

# When MULTI_TENANT_MODE=true, requests are matched to an institution by the
# first label of the hostname (e.g. al-madina.yourapp.com -> code
# "al-madina"). Set this to your bare platform domain so requests to it
# (marketing page / future super-admin login) are NOT treated as a tenant
# subdomain.
# PLATFORM_ROOT_DOMAIN=yourapp.com

# For local/dev testing without wildcard subdomains, send header
# "X-Tenant-Code: al-madina" on requests instead — it takes priority over
# the hostname. See docs/MULTI_TENANT_PLAN.md Part 3.

# Free wildcard-subdomain routing in production via a Cloudflare Worker (see
# cloudflare-worker/tenant-router.js) instead of a paid GCP load balancer +
# static IP. Set this to a long random string and configure the SAME value
# as the CF_WORKER_SHARED_SECRET secret on the Worker. Requests carrying the
# matching "X-Worker-Secret" header use "X-Original-Host" (set by the
# Worker) to resolve the tenant, since the Worker can't override the real
# Host header when forwarding to Cloud Run's default *.run.app URL. Leave
# unset to disable this path entirely.
# CF_WORKER_SHARED_SECRET=

# Multi-tenant Part 4 — Auth/JWT now binds each login token to the
# institution it was issued for (no separate env var; reuses
# MULTI_TENANT_MODE above). See docs/MULTI_TENANT_PLAN.md Part 4.

# ---------------------------------------------------------------------------
# Super-Admin panel (Part 5/6 — see docs/MULTI_TENANT_PLAN.md)
# ---------------------------------------------------------------------------
# Secret for the Super-Admin panel's own login session, kept separate from
# JWT_SECRET above so the two token types can never verify against each
# other. If unset, a value derived from JWT_SECRET is used automatically —
# fine for local/dev, but set a real independent 32+ character secret in
# production (required there; the app refuses to boot without it).
# Generate one with: openssl rand -base64 32
# PLATFORM_JWT_SECRET=replace-with-a-different-private-random-32-plus-character-secret

# The panel itself is served at /platform (no separate deploy needed — same
# Express server). There's no self-registration; create the first login with:
#   node server/scripts/registry-cli.js platform-admin-create "Your Name" you@example.com "Str0ngPass!"

# ---------------------------------------------------------------------------
# Billing + Migration Tooling (Part 6/6 — see docs/MULTI_TENANT_PLAN.md)
# ---------------------------------------------------------------------------
# How often (in minutes) the background job checks for expired trials/
# subscriptions in the registry and auto-suspends them. Minimum enforced is
# 5 minutes regardless of what's set here. Default: 60.
# BILLING_AUTOSUSPEND_INTERVAL_MINUTES=60

# Set to "true" to turn off the auto-suspend background job entirely (e.g.
# if you'd rather trigger it yourself via an external OS-level cron calling
# `node server/scripts/registry-cli.js expiry-scan`, or via the Super-Admin
# panel's "মেয়াদ স্ক্যান চালান" button).
# DISABLE_BILLING_AUTOSUSPEND=true

# Payments (bKash/Nagad/bank/etc) are recorded manually by the platform
# operator via the Super-Admin panel or:
#   node server/scripts/registry-cli.js record-payment <code> <amount> [method] [reference] [periodDays]
# No gateway credentials are needed for this — see the Part 6 write-up in
# docs/MULTI_TENANT_PLAN.md for why, and how to wire in a real gateway later.
