{
  "name": "madrasah-erp",
  "private": true,
  "version": "1.0.0",
  "scripts": {
    "dev": "concurrently -n client,server -c cyan,green \"npm run dev --prefix client\" \"npm run dev --prefix server\"",
    "build": "npm run build --prefix client",
    "start": "npm run start --prefix server",
    "sync:roles": "node scripts/sync-roles.js",
    "lint": "npm run lint --prefix client",
    "typecheck": "npm run typecheck --prefix client",
    "test:server": "node scripts/check-server.js",
    "test:backup": "node scripts/backup-restore.test.js",
    "check": "npm run sync:roles && npm run typecheck && npm run build && npm run test:server"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  }
}
