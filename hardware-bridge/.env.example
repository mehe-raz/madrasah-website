# Port this bridge itself listens on. Point the device's "Server IP/Port"
# setting (in its own menu — usually under Network/Communication settings)
# at THIS machine's IP and this port, not at the madrasah-website server.
BRIDGE_PORT=8090

# Base API URL of your running madrasah-website server, e.g.
# https://your-domain.com/api or http://192.168.1.50:3001/api if the bridge
# and the server are on the same local network. Must be reachable from
# wherever this bridge runs.
MADRASAH_API_BASE=https://your-domain.com/api

# deviceId + secretKey generated from the admin dashboard's device
# management page (Settings > হাজিরা ডিভাইস, POST /api/attendance-devices —
# see docs/ATTENDANCE_DEVICE_PLAN.md Phase 2). One bridge instance currently
# forwards for exactly one physical device; run a second bridge process
# (different BRIDGE_PORT, different DEVICE_ID/SECRET) for a second device.
DEVICE_ID=replace-with-the-deviceId-you-created
DEVICE_SECRET=replace-with-the-secretKey-you-were-shown-once

# fingerprint or card — must match how you're enrolling students'
# fingerprintId/cardUid on the admin side. If your device does both, this
# assumes fingerprint; edit index.js's forwardPunch() call if you need to
# vary it per record (some ADMS payloads include a Verify/mode field that
# distinguishes fingerprint vs card vs password punches — worth checking
# once you have a real device's raw log, see README.md).
IDENTIFIER_TYPE=fingerprint
