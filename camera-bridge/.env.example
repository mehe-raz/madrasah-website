# Base API URL of your running madrasah-website server, e.g.
# https://your-domain.com/api or http://192.168.1.50:3001/api if the bridge
# and the server are on the same local network. Must be reachable from
# wherever this bridge runs.
MADRASAH_API_BASE=https://your-domain.com/api

# deviceId + secretKey generated from the admin dashboard's
# "ক্যামেরা / Cameras" bridge management page (POST /api/cameras/bridges —
# see docs/CCTV_INTEGRATION_PLAN.md Phase 2). One bridge instance forwards
# for exactly one physical bridge machine, which can have several cameras
# attached (see CAMERA_MAP below) — this is different from
# hardware-bridge's one-device-one-secret model, camera_bridges is the
# multi-camera version of the same idea.
DEVICE_ID=replace-with-the-deviceId-you-created
DEVICE_SECRET=replace-with-the-secretKey-you-were-shown-once

# Address of the MQTT broker Frigate publishes events to (Mosquitto, from
# the docker-compose.yml this feature ships with). If Mosquitto runs on
# the same machine as this bridge (the usual setup), leave this as-is.
MQTT_BROKER_URL=mqtt://127.0.0.1:1883
MQTT_USERNAME=
MQTT_PASSWORD=

# Maps each Frigate camera name (exactly as written in Frigate's own
# config.yml, under "cameras:") to the numeric camera id shown on the
# admin dashboard's ক্যামেরা page (the "id" column, not the name — hover
# over/open a camera row to see it). Format: one "frigateName:id" pair per
# camera, separated by commas. Example for two cameras named "gate" and
# "yard" in Frigate, mapped to ids 3 and 4 in the dashboard:
#   CAMERA_MAP=gate:3,yard:4
# A Frigate event for a camera name not listed here is logged and skipped
# (never guessed) — see raw-events.log.
CAMERA_MAP=replace-with-your-camera-name-to-id-pairs

# Optional — base URL where Frigate's own web UI/API is reachable (e.g.
# http://127.0.0.1:5000). If set, and Frigate reports a clip was saved for
# a detection, this bridge includes a clipPath pointing at Frigate's clip
# API so the admin dashboard's event timeline can offer a "দেখুন" link.
# Leave blank to skip clip links (events still get recorded either way).
FRIGATE_URL=
